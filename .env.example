# The workbench runs without an LLM. To enable conversation and extraction,
# uncomment these lines and set a model exposed by your local server.
#
# Ollama example:
# LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
# LLM_MODEL=YOUR_OLLAMA_MODEL
#
# OpenAI example:
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=YOUR_OPENAI_MODEL
# LLM_API_KEY=YOUR_API_KEY

# Conversational sampling. Keep these fixed for comparable runs; they match
# evaluation/MODEL-SELECTION.md.
# LLM_TEMPERATURE=0.7
# LLM_TOP_P=0.8
# LLM_MAX_TOKENS=256

# Extraction needs a much larger budget than a conversational turn: the small
# conversational cap truncates the JSON mid-string. Defaults to 1536.
# LLM_EXTRACTION_MAX_TOKENS=1536

# Extraction is analysis, not conversation, and it is the participant who pays
# for any contention between them. A second, much smaller local model keeps the
# conversational weights free. Leave unset to share one model: extraction then
# waits for a quiet conversational model instead, which is correct but slower to
# show structure. Interpretations are attributed to whichever model made them.
# LLM_EXTRACTION_MODEL=llama3.2:latest
#
# How long the conversation must stay quiet before background extraction starts.
# A participant mid-thought speaks again within a second or two; starting a long
# analysis call the instant a reply lands would sit right on top of that turn.
# LLM_EXTRACTION_SETTLE=1.5

# Optional server port (defaults to 8765).
# PORT=8765

# Optional fully local half-duplex voice path. Paths must be absolute. The ASR
# language defaults to Spanish. `whisper-cli` and ffmpeg may also be on PATH.
# WHISPER_CLI=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL=/absolute/path/to/ggml-large-v3-turbo.bin
# WHISPER_LANGUAGE=es
# FFMPEG_CLI=/opt/homebrew/bin/ffmpeg
#
# Install the maintained Piper package from requirements-voice.txt, download an
# es_AR voice, and point this at its .onnx file. PIPER_CLI is only needed when
# using a standalone Piper executable instead of the Python package.
# PIPER_MODEL=/absolute/path/to/es_AR-VOICE.onnx
# PIPER_CLI=/absolute/path/to/piper
