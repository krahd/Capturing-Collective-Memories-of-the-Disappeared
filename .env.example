# The workbench runs without an LLM. To enable conversation and extraction,
# uncomment these lines and set a model exposed by your local server.
#
# Ollama example. Use an exact tag, never a moving one such as `:latest`: the
# record of what produced an interpretation is worthless if the name can point
# at different weights next month.
# LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
# LLM_MODEL=YOUR_OLLAMA_MODEL
# OLLAMA_KEEP_ALIVE=-1
# LLM_CONTEXT_TOKENS=8192
# LLM_ROUTER_CONTEXT_TOKENS=4096
# LLM_EXTRACTION_CONTEXT_TOKENS=4096
#
# Routing can run on a separate, smaller model. Measured on this corpus that
# saved about 40 ms per turn and cost seven critical routing failures, so it is
# left unset by default. If you set it, run `bash start.sh --routing-check`
# first: routing decides whether an utterance is testimony or a request to stop,
# and that boundary is not a place to save a tenth of a second on faith.
# LLM_ROUTER_MODEL=EXACT_SMALL_MODEL_TAG
#
# OpenAI example:
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=YOUR_OPENAI_MODEL
# LLM_API_KEY=YOUR_API_KEY

# Conversational sampling. Keep these fixed for comparable runs; they match
# evaluation/MODEL-SELECTION.md.
# LLM_TEMPERATURE=0.7
# LLM_TOP_P=0.8
# LLM_MAX_TOKENS=256

# Extraction needs a much larger budget than a conversational turn: the small
# conversational cap truncates the JSON mid-string. Defaults to 1536.
# LLM_EXTRACTION_MAX_TOKENS=1536

# Extraction is analysis, not conversation, and it is the participant who pays
# for any contention between them. By default it reuses LLM_ROUTER_MODEL when
# that is set; this override can choose another model. With neither set it
# shares the conversational model and relies on the idle gate instead, which is
# the current default: on this corpus a 3B model dropped the named person, one
# of two contradictory dates, and the hearsay and uncertainty markings — the
# distinctions the field exists to preserve. Extraction is background work and
# pre-emptible, so it can afford the larger model.
# Interpretations are attributed to whichever model made them.
# LLM_EXTRACTION_MODEL=EXACT_MODEL_TAG
#
# How long the conversation must stay quiet before background extraction starts.
# A participant mid-thought speaks again within a second or two; starting a long
# analysis call the instant a reply lands would sit right on top of that turn.
# LLM_EXTRACTION_SETTLE=1.5

# Optional server port (defaults to 8765).
# PORT=8765

# Optional fully local half-duplex voice path. Paths must be absolute. The ASR
# language defaults to Spanish. `whisper-cli` and ffmpeg may also be on PATH.
#
# Normal setup: the application launches whisper-server at startup, loads the
# model once and posts every turn to the resident process. `whisper-cli` stays
# configured only as a fallback for when that process cannot start.
# WHISPER_SERVER=/opt/homebrew/bin/whisper-server
# WHISPER_MODEL=/absolute/path/to/ggml-large-v3-turbo.bin
# WHISPER_LANGUAGE=es
# WHISPER_CLI=/opt/homebrew/bin/whisper-cli
# FFMPEG_CLI=/opt/homebrew/bin/ffmpeg
#
# Only change the address if the resident server must not use the default
# 127.0.0.1:8178. An address already answering is reused rather than duplicated,
# so this does not by itself stop the application from launching one.
# WHISPER_SERVER_URL=http://127.0.0.1:8178/inference
#
# Set this only when whisper-server is supervised elsewhere and must never be
# launched from here. Without a resident server every turn reloads a multi-
# gigabyte model through the CLI, which is the latency the resident path exists
# to remove.
# WHISPER_SERVER_EXTERNAL=1
#
# Install the maintained Piper package from requirements-voice.txt, download an
# es_AR voice, and point this at its .onnx file. PIPER_CLI is only needed when
# using a standalone Piper executable instead of the Python package.
# PIPER_MODEL=/absolute/path/to/es_AR-VOICE.onnx
# PIPER_CLI=/absolute/path/to/piper
