# The workbench runs without an LLM. To enable conversation and extraction,
# uncomment these lines and set a model exposed by your local server.
#
# Ollama example:
# LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
# LLM_MODEL=YOUR_OLLAMA_MODEL
#
# OpenAI example:
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=YOUR_OPENAI_MODEL
# LLM_API_KEY=YOUR_API_KEY

# Optional server port (defaults to 8765).
# PORT=8765
