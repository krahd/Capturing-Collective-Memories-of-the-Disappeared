      "audio_id": "",
      "transcription_detail": {}
    },
    {
      "id": "turn_95ec48b24a",
      "role": "user",
      "text": "En casa de mi abuela, en el Cerro, se juntaban los domingos. Yo me acuerdo del ruido.",
      "created_at": "2026-08-13T07:37:16.841939+00:00",
      "record_kind": "testimony",
      "intent": "",
      "move": "",
      "grounded_in": [],
      "input_mode": "text",
      "audio_id": "",
      "transcription_detail": {}
    },
    {
      "id": "turn_49539d5786",
      "role": "assistant",
      "text": "Contame de esas reuniones.",
      "created_at": "2026-08-13T07:37:16.841984+00:00",
      "record_kind": "system_intervention",
      "intent": "",
      "move": "",
      "grounded_in": [],
      "input_mode": "text",
