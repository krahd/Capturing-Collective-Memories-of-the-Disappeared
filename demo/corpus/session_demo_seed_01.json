    {
      "id": "turn_008001d976",
      "role": "user",
      "text": "Yo era chico, tendría nueve o diez. Esto habrá sido por el 77, por ahí.",
      "created_at": "2026-08-13T07:37:16.841909+00:00",
      "record_kind": "testimony",
      "intent": "",
      "move": "",
