      "transcription_detail": {}
    },
    {
      "id": "turn_39ec012d1b",
      "role": "user",
      "text": "Del Flaco yo no me acuerdo. Lo que sé es porque mi vieja contaba que aparecía por casa y hablaba horas con mi tío Aníbal.",
